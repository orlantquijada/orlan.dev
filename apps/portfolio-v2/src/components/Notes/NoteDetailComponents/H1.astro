---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { styles } from "./heading.styles";

type Props = HTMLAttributes<"h2">;

const { id, ...props } = Astro.props;
---

<h2
	{...props}
	id={id}
	class:list={[styles({ tag: "h2" }), "group flex items-center"]}
>
	<slot />
	<a aria-label={`Link to ${id}`} href={`#${id}`}>
		<Icon
			class="ml-[0.35em] inline h-[0.75em] w-[0.75em] opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100 group-focus-within:opacity-100"
			name="link-2"
		/>
	</a>
</h2>
