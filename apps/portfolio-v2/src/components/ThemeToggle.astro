---
import { query, storageKey } from "@/lib/theme-toggle";
---

<!-- Apply the effective theme before styles paint, including on client navigation. -->
<script define:vars={{ query, storageKey }} is:inline>
	(() => {
		// Inline scripts run again on Astro client navigation. Keep just one set of listeners.
		const key = Symbol.for("portfolio.theme-controller");
		window[key]?.abort();
		const controller = new AbortController();
		window[key] = controller;
		const { signal } = controller;
		const system = window.matchMedia("(prefers-color-scheme: dark)");

		const preference = () => {
			const stored = localStorage.getItem(storageKey);
			if (stored === "dark" || stored === "light") {
				return stored;
			}
			if (stored !== null) {
				localStorage.removeItem(storageKey);
			}
			return null;
		};
		const effectiveTheme = () =>
			preference() ?? (system.matches ? "dark" : "light");
		const applyTheme = (target, theme, suppressTransitions = false) => {
			const root = target.documentElement;
			if (suppressTransitions && !root.classList.contains(theme)) {
				const style = target.createElement("style");
				style.textContent =
					"*, *::before, *::after { transition: none !important; }";
				target.head.append(style);
				root.classList.toggle("dark", theme === "dark");
				root.classList.toggle("light", theme === "light");
				// biome-ignore lint/suspicious/noUnusedExpressions: forces a style recalculation before restoring transitions
				window.getComputedStyle(root).opacity;
				setTimeout(() => style.remove(), 1);
			} else {
				root.classList.toggle("dark", theme === "dark");
				root.classList.toggle("light", theme === "light");
			}
			for (const button of target.querySelectorAll(query)) {
				button.setAttribute("aria-label", theme);
			}
		};

		applyTheme(document, effectiveTheme());
		document.addEventListener(
			"DOMContentLoaded",
			() => applyTheme(document, effectiveTheme()),
			{ signal }
		);
		document.addEventListener(
			"click",
			(event) => {
				const { target } = event;
				if (!(target instanceof Element)) {
					return;
				}
				if (!target.closest(`${query}, [data-theme-toggle]`)) {
					return;
				}
				const next = effectiveTheme() === "dark" ? "light" : "dark";
				localStorage.setItem(storageKey, next);
				applyTheme(document, next, true);
			},
			{ signal }
		);
		system.addEventListener(
			"change",
			() => {
				if (preference() === null) {
					applyTheme(document, system.matches ? "dark" : "light", true);
				}
			},
			{ signal }
		);
		window.addEventListener(
			"storage",
			(event) => {
				if (event.key !== storageKey && event.key !== null) {
					return;
				}
				applyTheme(document, effectiveTheme(), true);
			},
			{ signal }
		);
		document.addEventListener(
			"astro:before-swap",
			(event) => {
				applyTheme(event.newDocument, effectiveTheme());
			},
			{ signal }
		);
		document.addEventListener(
			"astro:after-swap",
			() => {
				applyTheme(document, effectiveTheme());
			},
			{ signal }
		);
	})();
</script>
