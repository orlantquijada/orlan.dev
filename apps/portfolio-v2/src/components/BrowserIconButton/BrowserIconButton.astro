---
import type { HTMLAttributes } from "astro/types";

import { browserIconButtonStyles } from "./styles.ts";

type Props = HTMLAttributes<"a"> & { href: string; label: string };

const { class: className, href, label, ...props } = Astro.props;
---

<a {...props} class={browserIconButtonStyles({ class: className })} href={href}>
	<slot />
	<span class="sr-only">{label}</span>
</a>
