---
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";
import { EMAIL, GITHUB, LINKED_IN } from "@/utils/constants";
import { buttonStyles } from "./Button";

type SocialID = "github" | "linked-in" | "email";
type Social = {
	iconName: string;
	id: SocialID;
	title: string;
	url: string;
};

const socials: Social[] = [
	{
		iconName: "github2",
		id: "github",
		title: "Github",
		url: GITHUB,
	},
	{
		iconName: "linked-in",
		id: "linked-in",
		title: "LinkedIn",
		url: LINKED_IN,
	},
	{
		iconName: "email",
		id: "email",
		title: "Email",
		url: `mailto:${EMAIL}`,
	},
];

const btnClass = twMerge(
	buttonStyles({
		className: "flex items-center gap-2",
		translucent: true,
	})
);
---

<div data-animate style="--stagger: 4">
	<a class={btnClass} href="/resume" rel="noopener noreferrer" target="_blank">
		<Icon
			class="text-gray10 group-hover:text-gray1 transition-all"
			name="file-download"
			size={16}
			slot="icon"
		/>
		<span>View Resume</span>
	</a>
</div>

<div class="flex gap-x-5" data-animate style="--stagger: 5">
	{socials.map((social) => (
	<a
		aria-label={social.title}
		class="-mx-2 aspect-square px-2 text-gray9 transition-all ease-out hover:scale-110 hover:text-gray12"
		href={social.url}
		title={social.title}
	>
		<Icon class="size-6" name={social.iconName} slot="icon" />
	</a>
))}
</div>
